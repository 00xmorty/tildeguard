#!/usr/bin/env python3
"""Read-only, value-free POSIX PATH inspection. MIT licensed."""
import argparse
import json
import os

VERSION = "0.1.0"
MESSAGES = {
    "empty": "Empty entry searches the current directory.",
    "literal_home_tilde": "Literal home tilde is relative; it is not an expanded home directory.",
    "literal_other_tilde": "Leading tilde is literal here; review its intended shell expansion manually.",
    "relative": "Relative entry depends on the current working directory.",
}


def inspect_path(value):
    if value is None:
        return {"schema_version": 1, "status": "UNKNOWN", "entry_count": None,
                "findings": [], "reason": "PATH is not present in this process environment."}
    entries = value.split(":")
    findings = []
    for index, entry in enumerate(entries, 1):
        if not entry:
            kind = "empty"
        elif entry.startswith("/"):
            continue
        elif entry == "~" or entry.startswith("~/"):
            kind = "literal_home_tilde"
        elif entry.startswith("~"):
            kind = "literal_other_tilde"
        else:
            kind = "relative"
        findings.append({"entry": index, "kind": kind, "cwd_dependent": True})
    return {"schema_version": 1, "status": "REVIEW" if findings else "NO_FINDINGS",
            "entry_count": len(entries), "findings": findings}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="Emit value-free JSON.")
    parser.add_argument("--check", action="store_true", help="Exit 1 on findings, 2 on UNKNOWN.")
    parser.add_argument("--version", action="version", version=VERSION)
    args = parser.parse_args()
    report = inspect_path(os.environ.get("PATH"))
    if args.json:
        print(json.dumps(report, sort_keys=True))
    else:
        print("TildeGuard " + VERSION + ": " + report["status"])
        if report["status"] == "UNKNOWN":
            print(report["reason"])
        else:
            print("PATH entries: " + str(report["entry_count"]))
        for item in report["findings"]:
            print("Entry " + str(item["entry"]) + ": " + MESSAGES[item["kind"]])
        if any(f["kind"] == "literal_home_tilde" for f in report["findings"]):
            print('Example only: use "$HOME/.local/bin" instead of "~/.local/bin" in a reviewed shell configuration.')
            print("Not a generated patch: preserve your intended entry and order; do not paste blindly.")
        print("No values printed or commands executed. Relative entries may be intentional.")
        print("NO_FINDINGS does not certify PATH safety or command availability.")
    if args.check:
        return {"NO_FINDINGS": 0, "REVIEW": 1, "UNKNOWN": 2}[report["status"]]
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
